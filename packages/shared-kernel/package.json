{
  "name": "@mondapac-drive/shared-kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free shared kernel, copied from the marketplace: types used by the API and the apps.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./contexts": {
      "types": "./dist/contexts.d.ts",
      "default": "./dist/contexts.js"
    },
    "./authenticated-actor": {
      "types": "./dist/authenticated-actor.d.ts",
      "default": "./dist/authenticated-actor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14"
  }
}
