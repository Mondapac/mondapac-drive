{
  "code": "ZZ",
  "status": "active",
  "defaultLocale": "en-ZZ",
  "supportedLocales": ["en-ZZ"],
  "defaultCurrency": "JPY",
  "settlementCurrency": "JPY",
  "pricesIncludeTax": false,
  "timezone": "Pacific/Auckland",
  "requestLimits": {
    "anonymousIdentityPerMinute": 10,
    "defaultPerMinute": 60
  },
  "tax": {
    "defaultRateBps": 1500
  },
  "allowedOrigins": {
    "admin": ["https://dispatch.zz.test"],
    "merchant": [],
    "courier": []
  },
  "identity": {
    "password": {
      "minLength": 16,
      "maxLength": 100
    },
    "sessions": {
      "admin": {
        "idleTimeoutMinutes": 20,
        "absoluteLifetimeMinutes": 480
      },
      "courier": {
        "idleTimeoutMinutes": 600,
        "absoluteLifetimeMinutes": 20160
      }
    },
    "apiKeys": {
      "lifetimeDays": 90
    },
    "signInThrottles": {
      "accountOrigin": {
        "limit": 4,
        "windowMinutes": 10,
        "blockMinutes": 20
      },
      "account": {
        "limit": 15,
        "windowMinutes": 60,
        "blockMinutes": 30
      },
      "origin": {
        "limit": 25,
        "windowMinutes": 15,
        "blockMinutes": 15
      }
    },
    "mailThrottles": {
      "account": {
        "limit": 2,
        "windowMinutes": 60,
        "blockMinutes": 0
      },
      "origin": {
        "limit": 8,
        "windowMinutes": 30,
        "blockMinutes": 0
      }
    },
    "signInRecordRetentionDays": 60,
    "links": {
      "lifetimeMinutes": {
        "reset-password": 60,
        "enrol-second-factor": 45
      },
      "targets": {
        "admin": {
          "sign-in": "https://dispatch.zz.test/anmelden",
          "accept-invitation": "https://dispatch.zz.test/einladung",
          "enrol-second-factor": "https://dispatch.zz.test/zweiter-faktor",
          "reset-password": "https://dispatch.zz.test/passwort"
        },
        "courier": {
          "sign-in": "https://courier.zz.test/anmelden",
          "accept-invitation": "https://courier.zz.test/einladung",
          "reset-password": "https://courier.zz.test/passwort?ref=mail"
        }
      }
    },
    "invitations": {
      "lifetimeMinutes": {
        "admin": 2880,
        "courier": 7200
      }
    },
    "challenges": {
      "maxAttempts": 4,
      "lifetimeSeconds": 240
    },
    "secondFactorThrottles": {
      "account": {
        "limit": 8,
        "windowMinutes": 2880,
        "blockMinutes": 2880
      }
    },
    "signOutOthersThrottle": {
      "limit": 3,
      "windowMinutes": 30,
      "blockMinutes": 0
    },
    "customRoleLimits": {
      "platform": 50
    },
    "mail": {
      "fromAddress": "noreply@zz.test",
      "fromName": "ZZ Drive"
    }
  },
  "delivery": {
    "rateCard": {
      "vehicles": {
        "motorbike": {
          "baseFee": 500,
          "perKm": 100,
          "maxDistanceMetres": 20000,
          "maxWeightGrams": 10000,
          "maxVolumeLitres": 50,
          "temperatures": ["ambient"]
        },
        "van": {
          "baseFee": 2000,
          "perKm": 200,
          "maxDistanceMetres": 80000,
          "maxWeightGrams": 400000,
          "maxVolumeLitres": 2000,
          "temperatures": ["ambient", "chilled", "frozen"]
        }
      },
      "coldChainSurcharge": {
        "ambient": 0,
        "chilled": 250,
        "frozen": 400
      },
      "scheduledDiscountBps": 0
    },
    "coldChain": {
      "chilled": {
        "maxCelsius": 4
      },
      "frozen": {
        "maxCelsius": -18
      }
    },
    "scheduling": {
      "minLeadMinutes": 30,
      "maxDaysAhead": 3,
      "minWindowMinutes": 30
    }
  },
  "routing": {
    "provider": "google",
    "google": {
      "apiKeyEnv": "ZZ_ROUTING_API_KEY",
      "regionCode": "zz",
      "travelModes": {
        "bicycle": "BICYCLE",
        "motorbike": "DRIVE",
        "car": "DRIVE",
        "van": "DRIVE"
      },
      "trafficAware": false
    },
    "timeoutMs": 1000,
    "cacheTtlSeconds": 300,
    "cacheCoordinateDecimals": 3,
    "circuitBreaker": {
      "failureThreshold": 3,
      "openSeconds": 60
    },
    "straightLine": {
      "roadFactor": 1.5,
      "speedsKmh": {
        "bicycle": 12,
        "motorbike": 25,
        "car": 20,
        "van": 18
      }
    }
  }
}
