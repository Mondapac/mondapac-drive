{
  "code": "ZZ",
  "status": "active",
  "defaultLocale": "en-ZZ",
  "supportedLocales": ["en-ZZ"],
  "defaultCurrency": "JPY",
  "settlementCurrency": "JPY",
  "pricesIncludeTax": false,
  "timezone": "Pacific/Auckland",
  "requestLimits": {
    "anonymousIdentityPerMinute": 10,
    "defaultPerMinute": 60
  },
  "tax": {
    "defaultRateBps": 1500
  },
  "delivery": {
    "rateCard": {
      "vehicles": {
        "motorbike": {
          "baseFee": 500,
          "perKm": 100,
          "maxDistanceMetres": 20000,
          "maxWeightGrams": 10000,
          "maxVolumeLitres": 50,
          "temperatures": ["ambient"]
        },
        "van": {
          "baseFee": 2000,
          "perKm": 200,
          "maxDistanceMetres": 80000,
          "maxWeightGrams": 400000,
          "maxVolumeLitres": 2000,
          "temperatures": ["ambient", "chilled", "frozen"]
        }
      },
      "coldChainSurcharge": {
        "ambient": 0,
        "chilled": 250,
        "frozen": 400
      },
      "scheduledDiscountBps": 0
    },
    "coldChain": {
      "chilled": {
        "maxCelsius": 4
      },
      "frozen": {
        "maxCelsius": -18
      }
    },
    "scheduling": {
      "minLeadMinutes": 30,
      "maxDaysAhead": 3,
      "minWindowMinutes": 30
    }
  },
  "routing": {
    "provider": "google",
    "google": {
      "apiKeyEnv": "ZZ_ROUTING_API_KEY",
      "regionCode": "zz",
      "travelModes": {
        "bicycle": "BICYCLE",
        "motorbike": "DRIVE",
        "car": "DRIVE",
        "van": "DRIVE"
      },
      "trafficAware": false
    },
    "timeoutMs": 1000,
    "cacheTtlSeconds": 300,
    "cacheCoordinateDecimals": 3,
    "circuitBreaker": {
      "failureThreshold": 3,
      "openSeconds": 60
    },
    "straightLine": {
      "roadFactor": 1.5,
      "speedsKmh": {
        "bicycle": 12,
        "motorbike": 25,
        "car": 20,
        "van": 18
      }
    }
  },
  "dispatch": {
    "offerTimeoutSeconds": 20,
    "waveSize": 2,
    "maxRounds": 3,
    "scheduledLeadMinutes": 30,
    "searchRadiusMetres": 5000,
    "candidateLimit": 10
  },
  "notifications": {
    "webhooks": {
      "maxAttempts": 4,
      "firstRetrySeconds": 10,
      "maxRetrySeconds": 120
    },
    "sms": {
      "senderId": "ZZDrive",
      "optOutText": "STOP to end",
      "maxAttempts": 3,
      "allowedCallingCodes": ["999"],
      "templates": {
        "booked": "ZZ booked {reference} {trackingUrl}",
        "on_the_way": "ZZ on the way {trackingUrl}",
        "delivered": "ZZ delivered {reference}",
        "failed": "ZZ failed {reference}"
      }
    }
  },
  "fleet": {
    "documents": [
      {
        "type": "business_number",
        "employmentTypes": ["contractor"],
        "coldChainOnly": false,
        "perVehicle": false,
        "expires": false
      },
      {
        "type": "driving_permit",
        "vehicleTypes": ["motorbike", "van"],
        "coldChainOnly": false,
        "perVehicle": false,
        "expires": true
      },
      {
        "type": "vehicle_inspection",
        "vehicleTypes": ["van"],
        "coldChainOnly": false,
        "perVehicle": true,
        "expires": true
      },
      {
        "type": "cold_chain_training",
        "coldChainOnly": true,
        "perVehicle": false,
        "expires": true
      }
    ]
  },
  "payouts": {
    "earnings": {
      "vehicles": {
        "motorbike": {
          "perDelivery": 400,
          "perKm": 80
        },
        "van": {
          "perDelivery": 1500,
          "perKm": 150
        }
      },
      "coldChainBonus": {
        "ambient": 0,
        "chilled": 120,
        "frozen": 200
      },
      "waiting": {
        "freeMinutes": 3,
        "perMinute": 20,
        "maxPaidMinutes": 20
      }
    },
    "schedule": {
      "cadence": "daily",
      "weekday": 1,
      "time": "23:30"
    },
    "minimumPayout": 0,
    "tax": {
      "rateBps": 1500,
      "onTips": true,
      "businessIdRequired": false
    },
    "provider": {
      "accountCountry": "JP",
      "onboardingReturnUrl": "https://drive.example.test/zz/payouts/return",
      "onboardingRefreshUrl": "https://drive.example.test/zz/payouts/refresh"
    }
  },
  "tracking": {
    "ping": {
      "maxAgeSeconds": 60,
      "maxFutureSkewSeconds": 10,
      "minIntervalSeconds": 5,
      "maxAccuracyMetres": 200,
      "maxSpeedKmh": 120
    },
    "livePositionTtlSeconds": 120,
    "breadcrumbRetentionDays": 7,
    "trackingLinkTtlHours": 6,
    "streamIntervalSeconds": 3,
    "nearestCouriers": {
      "maxRadiusMetres": 8000,
      "maxResults": 20
    },
    "etaRefreshSeconds": 30
  }
}
