{
  "code": "ZZ",
  "status": "active",
  "defaultLocale": "en-ZZ",
  "supportedLocales": ["en-ZZ"],
  "defaultCurrency": "JPY",
  "settlementCurrency": "JPY",
  "pricesIncludeTax": false,
  "timezone": "Pacific/Auckland",
  "requestLimits": {
    "anonymousIdentityPerMinute": 10,
    "defaultPerMinute": 60
  },
  "tax": {
    "defaultRateBps": 1500
  },
  "delivery": {
    "rateCard": {
      "vehicles": {
        "motorbike": {
          "baseFee": 500,
          "perKm": 100,
          "maxDistanceMetres": 20000,
          "maxWeightGrams": 10000,
          "maxVolumeLitres": 50,
          "temperatures": ["ambient"]
        },
        "van": {
          "baseFee": 2000,
          "perKm": 200,
          "maxDistanceMetres": 80000,
          "maxWeightGrams": 400000,
          "maxVolumeLitres": 2000,
          "temperatures": ["ambient", "chilled", "frozen"]
        }
      },
      "coldChainSurcharge": {
        "ambient": 0,
        "chilled": 250,
        "frozen": 400
      },
      "scheduledDiscountBps": 0
    },
    "coldChain": {
      "chilled": {
        "maxCelsius": 4
      },
      "frozen": {
        "maxCelsius": -18
      }
    },
    "scheduling": {
      "minLeadMinutes": 30,
      "maxDaysAhead": 3,
      "minWindowMinutes": 30
    }
  },
  "routing": {
    "provider": "google",
    "google": {
      "apiKeyEnv": "ZZ_ROUTING_API_KEY",
      "regionCode": "zz",
      "travelModes": {
        "bicycle": "BICYCLE",
        "motorbike": "DRIVE",
        "car": "DRIVE",
        "van": "DRIVE"
      },
      "trafficAware": false
    },
    "timeoutMs": 1000,
    "cacheTtlSeconds": 300,
    "cacheCoordinateDecimals": 3,
    "circuitBreaker": {
      "failureThreshold": 3,
      "openSeconds": 60
    },
    "straightLine": {
      "roadFactor": 1.5,
      "speedsKmh": {
        "bicycle": 12,
        "motorbike": 25,
        "car": 20,
        "van": 18
      }
    }
  },
  "dispatch": {
    "offerTimeoutSeconds": 20,
    "waveSize": 2,
    "maxRounds": 3,
    "scheduledLeadMinutes": 30,
    "searchRadiusMetres": 5000,
    "candidateLimit": 10
  }
}
