// The notifications module's tables. Every model carries marketId and tenantId, which the
// platform's market guard pins on every query. No personal data is stored: a recipient's phone
// number is read from the delivery module when an SMS is sent, and a webhook body holds ids and
// statuses only. Webhook signing secrets are derived, never stored (secret_version only).

/// A merchant's webhook endpoint. The URL never changes; a new URL is a new subscription.
model NotificationsWebhookSubscription {
  id            String   @id @db.Uuid
  marketId      String   @map("market_id") @db.VarChar(8)
  tenantId      String   @map("tenant_id")
  merchantId    String   @map("merchant_id") @db.VarChar(64)
  url           String   @db.VarChar(2048)
  eventTypes    String[] @map("event_types")
  /// The version the signing secret is derived with; a rotation adds one.
  secretVersion Int      @map("secret_version")
  /// Until when secret_version - 1 still signs next to the current one (rotation overlap).
  previousSecretValidUntil DateTime? @map("previous_secret_valid_until") @db.Timestamptz(6)
  status        String   @db.VarChar(16)
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  version       Int

  calls NotificationsWebhookCall[]

  @@unique([marketId, id])
  @@index([marketId, merchantId])
  @@map("webhook_subscriptions")
  @@schema("notifications")
}

/// One delivery change queued for one subscription, with its retry state.
model NotificationsWebhookCall {
  id             String    @id @db.Uuid
  marketId       String    @map("market_id") @db.VarChar(8)
  tenantId       String    @map("tenant_id")
  subscriptionId String    @map("subscription_id") @db.Uuid
  /// The delivery outbox event id: the merchant's deduplication key (Drive-Event-Id).
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(64)
  /// The JSON body every attempt sends, as text so that its bytes never change.
  body           String
  status         String    @db.VarChar(16)
  attempts       Int
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastStatusCode Int?      @map("last_status_code")
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(64)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  deadAt         DateTime? @map("dead_at") @db.Timestamptz(6)

  subscription NotificationsWebhookSubscription @relation(fields: [marketId, subscriptionId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([marketId, subscriptionId, eventId])
  @@index([marketId, status, nextAttemptAt])
  @@map("webhook_calls")
  @@schema("notifications")
}

/// One recipient SMS of one delivery, with its retry state. No number and no text are stored.
model NotificationsSmsMessage {
  id                String    @id @db.Uuid
  marketId          String    @map("market_id") @db.VarChar(8)
  tenantId          String    @map("tenant_id")
  deliveryId        String    @map("delivery_id") @db.Uuid
  kind              String    @db.VarChar(16)
  eventId           String    @map("event_id") @db.Uuid
  /// The merchant's order reference, for the template.
  reference         String    @db.VarChar(128)
  status            String    @db.VarChar(16)
  attempts          Int
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode     String?   @map("last_error_code") @db.VarChar(64)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(64)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  deadAt            DateTime? @map("dead_at") @db.Timestamptz(6)

  @@unique([marketId, deliveryId, kind])
  @@index([marketId, status, nextAttemptAt])
  @@map("sms_messages")
  @@schema("notifications")
}

/// Delivery events notifications' handlers consumed, for at-most-once handling.
model NotificationsInbox {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("notifications")
}

/// The push device of one courier session (handoff 33). The Expo token is sealed (AES-GCM, bound
/// to the account) and found by its keyed digest; it is never stored in clear. A session has one
/// device and a token one session; the row is dropped on sign-out, when identity ends the
/// account's sessions, and is never used past expires_at (the session's absolute lifetime).
model NotificationsPushDevice {
  id           String   @id @db.Uuid
  marketId     String   @map("market_id") @db.VarChar(8)
  tenantId     String   @map("tenant_id")
  /// The courier's identity account id.
  accountId    String   @map("account_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  platform     String   @db.VarChar(8)
  tokenSealed  String   @map("token_sealed") @db.VarChar(512)
  /// HMAC-SHA256 of the token under a derived key, hex.
  tokenLookup  String   @map("token_lookup") @db.Char(64)
  registeredAt DateTime @map("registered_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([marketId, sessionId])
  @@unique([marketId, tokenLookup])
  @@index([marketId, accountId])
  @@map("push_devices")
  @@schema("notifications")
}
