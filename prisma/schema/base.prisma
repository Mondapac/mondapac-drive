// Shared Prisma configuration, as in the marketplace (its ADR-0004): one file per module next to
// this one; each module owns exactly one PostgreSQL schema and no relation crosses schemas.

generator client {
  provider            = "prisma-client"
  output              = "../../apps/api/src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

// The model map of the market guard and the "model to owning module" rule (marketplace platform
// persistence design, section 9): written on every `prisma generate`, beside the client.
generator modelMap {
  provider = "node scripts/generate-model-map.mjs"
  output   = "../../apps/api/src/generated/model-map.ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["delivery", "notifications", "platform", "fleet", "tracking"]
}
