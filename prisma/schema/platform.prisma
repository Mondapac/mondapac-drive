// Platform infrastructure tables (schema "platform"). Not a business module: these tables
// are written through platform/* services only (ADR-0004 decision 7, ADR-0008).
// Physical design and the hand-written migration SQL: docs/design/data/platform.md

/// Append-only audit trail (ADR-0004 decision 7, ADR-0009 pattern V4; IMP-10, CERT-32,
/// IMP-06/SEL-08). Rows are never updated or deleted: a database trigger rejects UPDATE,
/// DELETE and TRUNCATE. CHECK constraints and the triggers are hand-written in the
/// migration because Prisma cannot express them.
/// No personal data in any column: actors and targets are opaque ids, and before/after
/// hold allow-listed non-personal fields only (ADR-0009 decision 6).
model AuditLog {
  /// UUIDv7 generated by platform/audit.
  id            String         @id @db.Uuid
  /// Market code. Mandatory: every audited action resolves to exactly one market (ADR-0003).
  marketId      String         @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001). Supplied by the writer; deliberately no database default.
  tenantId      String         @map("tenant_id")
  /// Instant of the audited action, from the injected Clock (ADR-0005), UTC, in whole
  /// milliseconds (CHECK audit_log_occurred_at_check; docs/design/data/platform.md 11.2).
  occurredAt    DateTime       @map("occurred_at") @db.Timestamptz(6)
  /// USER = an authenticated principal (actor_id required); SYSTEM = job, worker or relay;
  /// ANONYMOUS = a request with no session whose credential binds one account or invitation,
  /// named in target_id or after.boundSubjectId (docs/design/domain/platform-audit.md W4a).
  actorType     String         @map("actor_type")
  /// identity user id of the real actor. Plain id, no FK across schemas.
  actorId       String?        @map("actor_id") @db.Uuid
  /// During impersonation (SEL-08, IMP-06): the user the actor was acting as.
  actingAsId    String?        @map("acting_as_id") @db.Uuid
  /// Stable action code, "<module>.<subject>.<verb>", e.g. "certification.seller-certification.approved".
  action        String
  /// Aggregate or record type of the target, "<module>.<type>", e.g. "certification.seller-certification".
  targetType    String         @map("target_type")
  /// Target identifier as text: usually a UUID, but some targets have natural keys (a market code, a config key).
  targetId      String         @map("target_id")
  /// State before the change (null for creations). JSON object, non-personal fields only.
  before        Json?          @db.JsonB
  /// State after the change (null for deletions). JSON object, non-personal fields only.
  after         Json?          @db.JsonB
  /// Correlation id of the request, job run or event that caused the action.
  correlationId String         @map("correlation_id")
  /// Seals of this row, at most one per chain epoch (docs/design/data/platform.md 11.3).
  seals         AuditLogSeal[]

  /// Admin audit list and the sealer's keyset on (occurred_at, id); referenced by the seal's foreign key.
  @@unique([marketId, occurredAt, id], map: "audit_log_market_id_occurred_at_id_key")
  /// Audit history of one entity (CERT-32: a certification's decisions), newest first.
  @@index([marketId, targetType, targetId, occurredAt], map: "audit_log_market_id_target_type_target_id_occurred_at_idx")
  /// What one actor did (IMP-06: review of an admin's actions and impersonation sessions).
  @@index([marketId, actorId, occurredAt], map: "audit_log_market_id_actor_id_occurred_at_idx")
  @@map("audit_log")
  @@schema("platform")
}

/// One seal of one audit row in one chain epoch: the hash chain of the audit log (ADR-0009
/// V4; docs/design/domain/platform-audit.md 6; physical design docs/design/data/platform.md
/// 11.3). Append-only: a database trigger rejects UPDATE, DELETE and TRUNCATE for every role,
/// and the application holds SELECT and INSERT only. Written only by the sealer in
/// platform/persistence/audit/ (identity slice 6b). The CHECKs and the triggers are
/// hand-written in the migration. No personal data: ids, times and hashes only.
model AuditLogSeal {
  marketId        String   @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001), from the sealer's context; no database default.
  tenantId        String   @map("tenant_id")
  /// Chain epoch, 1 from the first seal; a new epoch only through the recovery command (11.13). No default.
  epoch           Int
  /// 1, 2, 3, ... per Market and epoch.
  chainSeq        BigInt   @map("chain_seq")
  /// The sealed audit row.
  auditLogId      String   @map("audit_log_id") @db.Uuid
  /// Copy of the row's occurred_at, kept equal by the foreign key (11.3).
  auditOccurredAt DateTime @map("audit_occurred_at") @db.Timestamptz(6)
  /// 32 bytes: SHA-256 of the canonical row (platform-audit.md 6.2).
  rowHash         Bytes    @map("row_hash")
  /// 32 bytes: SHA-256 of the link, with hash_version and epoch in its input (6.2).
  chainHash       Bytes    @map("chain_hash")
  /// Sealed below the watermark (6.1 option A); part of the chain hash.
  late            Boolean
  /// 1 today (6.2).
  hashVersion     Int      @map("hash_version") @db.SmallInt
  /// From the sealer's Clock; not part of any hash.
  sealedAt        DateTime @map("sealed_at") @db.Timestamptz(6)
  auditLog        AuditLog @relation(fields: [marketId, auditOccurredAt, auditLogId], references: [marketId, occurredAt, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, epoch, chainSeq], map: "audit_log_seal_pkey")
  @@unique([marketId, epoch, auditOccurredAt, auditLogId], map: "audit_log_seal_market_id_epoch_occurred_at_id_key")
  @@map("audit_log_seal")
  @@schema("platform")
}

/// A chain head at checkpoint time, also sent to the anchor (docs/design/domain/platform-audit.md
/// 7.1 step 5 and 8; docs/design/data/platform.md 11.4). Append-only like the seal; no foreign
/// key to the seal, because checkpoints outlive dropped seals. The CHECKs and the triggers are
/// hand-written in the migration. No personal data.
model AuditChainCheckpoint {
  marketId    String   @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); no database default.
  tenantId    String   @map("tenant_id")
  /// The epoch of the checkpointed seal.
  epoch       Int
  /// The head at checkpoint time.
  chainSeq    BigInt   @map("chain_seq")
  /// 32 bytes: the chain_hash of that seal.
  chainHash   Bytes    @map("chain_hash")
  hashVersion Int      @map("hash_version") @db.SmallInt
  /// From the sealer's Clock.
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)

  @@id([marketId, epoch, chainSeq], map: "audit_chain_checkpoint_pkey")
  @@map("audit_chain_checkpoint")
  @@schema("platform")
}

/// One wrapped data key per subject (platform-foundations design 4; ADR-0009 decisions 6 and
/// 8; docs/design/data/identity.md 3.2). Read and written only by the SubjectKeyService through
/// its store in platform/persistence/. A subject has one key for life: the primary key on the
/// subject refuses a second one, in any Market. Destroying the key sets wrapped_key to NULL and
/// keeps the row as a tombstone; a hand-written trigger makes that one-way and freezes the
/// identity columns for every role, and the application has no DELETE. CHECKs, the trigger
/// and the column-level grants are hand-written in the migration. Not personal data: an
/// opaque id and ciphertext.
model SubjectKey {
  /// An account id or a seller id; the table does not record which (ids never repeat across kinds).
  subjectId     String    @id @map("subject_id") @db.Uuid
  /// Market of the subject (ADR-0003); bound into the wrap, so a row moved to another Market does not unwrap.
  marketId      String    @map("market_id") @db.VarChar(8)
  /// Tenant seam (ADR-0001); supplied by the writer, no database default. Not bound into the wrap.
  tenantId      String    @map("tenant_id")
  /// Always 1 in Phase 2; part of the wrap binding (PF 4 row 10).
  keyVersion    Int       @map("key_version")
  /// The data key wrapped under the regional wrapping key, as a versioned text envelope; NULL once destroyed.
  wrappedKey    String?   @map("wrapped_key")
  /// Which regional wrapping key and version wrapped it (PF 4 row 2).
  wrappingKeyId String    @map("wrapping_key_id")
  /// From Clock, UTC.
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  /// The last rotation of the wrapping key.
  rewrappedAt   DateTime? @map("rewrapped_at") @db.Timestamptz(6)
  /// Set by destroyKey; the row stays as a tombstone.
  destroyedAt   DateTime? @map("destroyed_at") @db.Timestamptz(6)

  @@map("subject_keys")
  @@schema("platform")
}

/// One delivery of one event to one subscriber (ADR-0006 decisions 4 and 5; platform persistence
/// design 6.4, PM3; docs/design/data/identity.md 3.8): the work queue of the in-process event
/// bus, its retries and its dead letters. The relay's bus inserts a row per event and
/// subscriber in the relay's transaction, ignoring a repeated key; the dispatcher claims due
/// rows with FOR UPDATE SKIP LOCKED; the subscriber's unit marks its row delivered (runOnce).
/// The envelope is a copy of the outbox row, so the dispatcher never reads a module schema, and
/// it is never updated. Ids, codes and permission keys only: no personal data in any column.
/// The CHECKs, the partial claim index and the column-level grants are hand-written in the
/// migration.
model EventDelivery {
  /// The event's id (the outbox row's event_id).
  eventId          String    @map("event_id") @db.Uuid
  /// "<module>.<handler>": the subscription that receives the event.
  subscriber       String
  marketId         String    @map("market_id") @db.VarChar(8)
  tenantId         String    @map("tenant_id")
  /// pending | delivered | dead.
  status           String
  /// Claims so far; each claim counts one.
  attempts         Int
  /// When the row is next due; moved forward by the back-off at every claim.
  nextAttemptAt    DateTime  @map("next_attempt_at") @db.Timestamptz(6)
  /// The envelope copy (data design 3.1); never updated.
  type             String
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// The last failure, as a code; never a message or a row value (P 12.3).
  errorCode        String?   @map("error_code")
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)
  deadAt           DateTime? @map("dead_at") @db.Timestamptz(6)

  /// ADR-0006 decision 4: one row per event and subscriber.
  @@id([eventId, subscriber])
  @@map("event_delivery")
  @@schema("platform")
}

/// @market-scope none: the generic per-origin rate limiter counts across Markets (PF I11).
/// One fixed window per limit class and origin of the generic rate limiter (identity design 6.8
/// and 13; buyer scale-out item (a)), shared by every API instance. Written only by the
/// PostgreSQL store of `rate-limiter-flexible` through platform/persistence/, whose statements
/// fix the column names, their order and the key shape ("<limit class>:<origin key>"). The key
/// holds the keyed hash of the origin, never an address (identity data design HF3). Transient:
/// the store deletes windows that ended over an hour ago. CHECKs and grants are hand-written in
/// the migration.
model RateLimitCounter {
  /// "<limit class>:<64 lowercase hex of HMAC-SHA-256 of the origin>".
  key    String @id @db.VarChar(255)
  /// Requests counted in the window.
  points Int
  /// End of the window, epoch milliseconds (the package's clock).
  expire BigInt

  @@map("rate_limit_counters")
  @@schema("platform")
}
