// The delivery module's tables. Money is minor units (BigInt) plus a currency. Every model carries
// marketId and tenantId, which the platform's market guard pins on every query. Points are stored
// as latitude and longitude; the PostGIS geography columns are generated from them by the database
// (never written by Prisma). Status changes are appended to delivery_events and never edited.

/// One booked delivery. (market_id, merchant_id, external_reference) is the idempotency key.
model DeliveryDelivery {
  id                String                                 @id @db.Uuid
  marketId          String                                 @map("market_id") @db.VarChar(8)
  tenantId          String                                 @map("tenant_id")
  merchantId        String                                 @map("merchant_id") @db.VarChar(64)
  externalReference String                                 @map("external_reference") @db.VarChar(128)
  serviceAreaCode   String                                 @map("service_area_code") @db.VarChar(64)
  status            String                                 @db.VarChar(24)
  mode              String                                 @db.VarChar(16)
  windowStart       DateTime?                              @map("window_start") @db.Timestamptz(6)
  windowEnd         DateTime?                              @map("window_end") @db.Timestamptz(6)
  /// Pickup and drop-off: address, postcode, contact. The point is in the columns below.
  pickup            Json
  dropoff           Json
  pickupLat         Float                                  @map("pickup_lat")
  pickupLng         Float                                  @map("pickup_lng")
  dropoffLat        Float                                  @map("dropoff_lat")
  dropoffLng        Float                                  @map("dropoff_lng")
  /// Generated by the database from pickup_lat and pickup_lng (GENERATED ALWAYS ... STORED).
  pickupPoint       Unsupported("geography(Point, 4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(pickup_lng, pickup_lat), 4326))::geography")) @map("pickup_point")
  /// Generated by the database from dropoff_lat and dropoff_lng.
  dropoffPoint      Unsupported("geography(Point, 4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(dropoff_lng, dropoff_lat), 4326))::geography")) @map("dropoff_point")
  weightGrams       Int                                    @map("weight_grams")
  volumeLitres      Int                                    @map("volume_litres")
  temperature       String                                 @db.VarChar(8)
  vehicle           String                                 @db.VarChar(16)
  distanceMetres    Int                                    @map("distance_metres")
  /// The quote as booked, including its breakdown.
  quote             Json
  totalAmount       BigInt                                 @map("total_amount")
  taxAmount         BigInt                                 @map("tax_amount")
  currency          String                                 @db.VarChar(3)
  courierId         String?                                @map("courier_id") @db.VarChar(64)
  createdAt         DateTime                               @map("created_at") @db.Timestamptz(6)
  version           Int

  events DeliveryEvent[]

  @@unique([marketId, id])
  @@unique([marketId, merchantId, externalReference])
  @@index([marketId, status])
  /// Hand-written GiST index for "deliveries near a courier" and dispatch zones.
  @@index([pickupPoint], type: Gist)
  @@map("deliveries")
  @@schema("delivery")
}

/// Append-only history of a delivery: one row per recorded event.
model DeliveryEvent {
  deliveryId         String   @map("delivery_id") @db.Uuid
  sequence           Int
  marketId           String   @map("market_id") @db.VarChar(8)
  tenantId           String   @map("tenant_id")
  type               String   @db.VarChar(32)
  status             String   @db.VarChar(24)
  courierId          String?  @map("courier_id") @db.VarChar(64)
  vehicle            String?  @db.VarChar(16)
  temperatureCelsius Decimal? @map("temperature_celsius") @db.Decimal(4, 1)
  proof              Json?
  reason             String?  @db.VarChar(500)
  at                 DateTime @db.Timestamptz(6)

  delivery DeliveryDelivery @relation(fields: [marketId, deliveryId], references: [marketId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([marketId, deliveryId, sequence])
  @@map("delivery_events")
  @@schema("delivery")
}

/// Events of the delivery module, appended in the transaction of the change and published by the
/// relay (platform persistence design 5). The columns are the platform's outbox contract.
model DeliveryOutbox {
  /// UUIDv7 stamped by the outbox writer.
  eventId          String    @id @map("event_id") @db.Uuid
  /// "delivery.<subject>-<verb>.v<N>"; the CHECK refuses another module's type.
  type             String
  /// The instant the use case took from Clock (UTC).
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Market of the unit that wrote the event; stamped by the writer.
  marketId         String    @map("market_id") @db.VarChar(8)
  /// Tenant seam; stamped by the writer, no database default.
  tenantId         String    @map("tenant_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// The aggregate's version after the change; unique per aggregate.
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id")
  /// The consumed event that caused this one, or null.
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// Set by the relay when the event was handed to the bus; the only column that changes.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  @@unique([marketId, aggregateId, aggregateVersion])
  @@map("outbox")
  @@schema("delivery")
}

/// The events a delivery subscriber has handled (platform persistence design 6.4): `runOnce`
/// inserts (event_id, handler) in the handler's own unit and skips the work when the row exists.
/// Written only by platform/persistence/outbox/.
model DeliveryInbox {
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "delivery.<handler>".
  handler     String
  marketId    String   @map("market_id") @db.VarChar(8)
  tenantId    String   @map("tenant_id")
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("delivery")
}
