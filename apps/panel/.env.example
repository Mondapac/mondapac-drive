# Operations panel (apps/panel). Copy to .env.local. See the marketplace ADR-0034.
# The API the panel's server relays to.
API_BASE_URL=http://localhost:3000
# origin=MARKET pairs. Locally use *.localhost: cookies ignore ports, so the two panels need
# different host names (ADR-0034 decision 3).
PANEL_HOSTS=http://admin.localhost:3002=AU
# The Market password length rule shown as help text, min-max.
PANEL_PASSWORD_LENGTH=15-128
PANEL_MARKET_NAME=Australia
# The Market locale (defaultLocale in config/markets/<ID>.json) as a canonical BCP 47 tag.
# Required, no default; sets the language of formats and dates.
PANEL_LOCALE=en-AU
PANEL_SUPPORT_EMAIL=support@example.com

# Client address (ADR-0037 decision 9). server.mjs sets the address of every request from the
# socket peer (socket) or, when the peer is inside EDGE_CIDRS, from the one header the edge sets
# (edge). Required, no default. Locally: socket.
CLIENT_ADDRESS_SOURCE=socket
# edge only. Comma-separated CIDRs of the edge, none wider than /16 (IPv4) or /48 (IPv6).
EDGE_CIDRS=
# edge only. The one lowercase header name the edge sets, for example cf-connecting-ip.
EDGE_CLIENT_ADDRESS_HEADER=
# Signing key for the address the API verifies. Both empty: no header is sent, which is only
# accepted on *.localhost hosts. keyId matches [a-z0-9-]{1,32}; the secret is base64 of 32+ bytes.
BFF_CLIENT_ADDRESS_KEY_ID=
BFF_CLIENT_ADDRESS_SECRET=
