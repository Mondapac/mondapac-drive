// Allowed: a second outbox identical to alpha's, and an inbox keyed by the event id (ADR-0006).

model BetaOutbox {
  eventId   String @id @map("event_id") @db.Uuid
  marketId  String @map("market_id")
  tenantId  String @map("tenant_id")
  type      String
  payload   Json

  @@map("outbox")
  @@schema("beta")
}

model BetaInbox {
  eventId  String @map("event_id") @db.Uuid
  handler  String
  marketId String @map("market_id")
  tenantId String @map("tenant_id")

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("beta")
}

/// The delivery record of an event: keyed by the event id, without marketId (P 9).
model BetaEventDelivery {
  eventId  String @map("event_id") @db.Uuid
  consumer String
  marketId String @map("market_id")
  tenantId String @map("tenant_id")

  @@id([eventId, consumer])
  @@map("event_delivery")
  @@schema("beta")
}
