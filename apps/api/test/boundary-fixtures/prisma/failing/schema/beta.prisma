// Deliberate violations of P 9; boundaries.spec.ts expects each one, and nothing else.

/// Violation: an outbox whose fields differ from alpha's (no payload, an extra column).
model BetaOutbox {
  eventId   String @id @map("event_id") @db.Uuid
  marketId  String @map("market_id")
  tenantId  String @map("tenant_id")
  type      String
  note      String

  @@map("outbox")
  @@schema("beta")
}

/// Allowed (control): an inbox keyed by the event id (ADR-0006).
model BetaInbox {
  eventId  String @map("event_id") @db.Uuid
  handler  String
  marketId String @map("market_id")
  tenantId String @map("tenant_id")

  @@id([eventId, handler])
  @@map("inbox")
  @@schema("beta")
}

/// Allowed (control): a scoped model of beta that alpha's files name below.
model BetaThing {
  id       String @id @db.Uuid
  marketId String @map("market_id")
  tenantId String @map("tenant_id")

  @@schema("beta")
}
