# Local settings for development. Copy to .env; never commit .env.
# The roles come from scripts/db/bootstrap-dev.sql (docker compose runs it on a fresh volume).
PORT=3100
NODE_ENV=development
API_DOCS_ENABLED=true
LOG_LEVEL=info
# Which role this process plays: api (HTTP) or worker (relay, dispatcher, scheduled jobs).
APP_ROLE=api
HOSTED_MARKETS=AU

# The application login. It is a member of drive_app and owns nothing.
DATABASE_URL=postgresql://drive_api:drive_api@localhost:5433/drive
DATABASE_POOL_MAX=10
# The migration role, owner of the database. Only the Prisma CLI and the test and migration
# scripts read it; the application refuses to start when it is set in its environment.
MIGRATION_DATABASE_URL=postgresql://drive_migrator:drive_migrator@localhost:5433/drive

# A local mail catcher and object store, when a feature needs them.
# MAIL_CATCHER_URL=http://localhost:8025
# OBJECT_STORE_DIR=./.object-store

# The BFF client-address header (marketplace ADR-0037): off until a panel server is added.
TRUSTED_BFF_CIDRS=
CLIENT_ADDRESS_KEYS=
# Redis (route cache, live courier positions). Unset: each process keeps its own in-memory
# store; tracking refuses that when NODE_ENV is production, which also requires rediss://.
REDIS_URL=redis://localhost:6380
# Road routing and geocoding for AU (config/markets/AU.json routing.google.apiKeyEnv). Unset: every
# route is a straight-line estimate and geocoding answers "unavailable".
# GOOGLE_MAPS_API_KEY=

# Notifications: the key every webhook signing secret is derived from (base64, 32+ random bytes;
# a local stand-in is used when unset in development and test), and Twilio for recipient SMS
# (unset: SMS are retried and then dead-lettered).
# NOTIFICATIONS_WEBHOOK_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
