{
  "code": "AU",
  "status": "planned",
  "defaultLocale": "en-AU",
  "supportedLocales": ["en-AU"],
  "defaultCurrency": "AUD",
  "settlementCurrency": "AUD",
  "pricesIncludeTax": true,
  "timezone": "Australia/Brisbane",
  "requestLimits": {
    "anonymousIdentityPerMinute": 20,
    "defaultPerMinute": 300
  },
  "tax": {
    "defaultRateBps": 1000
  },
  "delivery": {
    "rateCard": {
      "vehicles": {
        "bicycle": {
          "baseFee": 700,
          "perKm": 120,
          "maxDistanceMetres": 8000,
          "maxWeightGrams": 8000,
          "maxVolumeLitres": 40,
          "temperatures": ["ambient", "chilled"]
        },
        "motorbike": {
          "baseFee": 800,
          "perKm": 130,
          "maxDistanceMetres": 25000,
          "maxWeightGrams": 15000,
          "maxVolumeLitres": 60,
          "temperatures": ["ambient", "chilled"]
        },
        "car": {
          "baseFee": 1000,
          "perKm": 150,
          "maxDistanceMetres": 60000,
          "maxWeightGrams": 50000,
          "maxVolumeLitres": 300,
          "temperatures": ["ambient", "chilled", "frozen"]
        },
        "van": {
          "baseFee": 2500,
          "perKm": 220,
          "maxDistanceMetres": 100000,
          "maxWeightGrams": 500000,
          "maxVolumeLitres": 3000,
          "temperatures": ["ambient", "chilled", "frozen"]
        }
      },
      "coldChainSurcharge": {
        "ambient": 0,
        "chilled": 300,
        "frozen": 500
      },
      "scheduledDiscountBps": 1000
    },
    "coldChain": {
      "chilled": {
        "maxCelsius": 5
      },
      "frozen": {
        "maxCelsius": -15
      }
    },
    "scheduling": {
      "minLeadMinutes": 60,
      "maxDaysAhead": 7,
      "minWindowMinutes": 60
    }
  },
  "routing": {
    "provider": "google",
    "google": {
      "apiKeyEnv": "GOOGLE_MAPS_API_KEY",
      "regionCode": "au",
      "travelModes": {
        "bicycle": "BICYCLE",
        "motorbike": "TWO_WHEELER",
        "car": "DRIVE",
        "van": "DRIVE"
      },
      "trafficAware": true
    },
    "timeoutMs": 2000,
    "cacheTtlSeconds": 900,
    "cacheCoordinateDecimals": 4,
    "circuitBreaker": {
      "failureThreshold": 5,
      "openSeconds": 30
    },
    "straightLine": {
      "roadFactor": 1.3,
      "speedsKmh": {
        "bicycle": 15,
        "motorbike": 30,
        "car": 30,
        "van": 25
      }
    }
  },
  "tracking": {
    "ping": {
      "maxAgeSeconds": 120,
      "maxFutureSkewSeconds": 30,
      "minIntervalSeconds": 3,
      "maxAccuracyMetres": 500,
      "maxSpeedKmh": 160
    },
    "livePositionTtlSeconds": 300,
    "breadcrumbRetentionDays": 30,
    "trackingLinkTtlHours": 24,
    "streamIntervalSeconds": 5,
    "nearestCouriers": {
      "maxRadiusMetres": 20000,
      "maxResults": 50
    },
    "etaRefreshSeconds": 60
  }
}
