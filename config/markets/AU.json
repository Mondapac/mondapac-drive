{
  "code": "AU",
  "status": "planned",
  "defaultLocale": "en-AU",
  "supportedLocales": ["en-AU"],
  "defaultCurrency": "AUD",
  "settlementCurrency": "AUD",
  "pricesIncludeTax": true,
  "timezone": "Australia/Brisbane",
  "requestLimits": {
    "anonymousIdentityPerMinute": 20,
    "defaultPerMinute": 300
  },
  "tax": {
    "defaultRateBps": 1000
  },
  "allowedOrigins": {
    "admin": [],
    "merchant": [],
    "courier": []
  },
  "identity": {
    "password": {
      "minLength": 15,
      "maxLength": 128
    },
    "sessions": {
      "admin": {
        "idleTimeoutMinutes": 30,
        "absoluteLifetimeMinutes": 720
      },
      "courier": {
        "idleTimeoutMinutes": 1440,
        "absoluteLifetimeMinutes": 43200
      }
    },
    "apiKeys": {
      "lifetimeDays": 365
    },
    "signInThrottles": {
      "accountOrigin": {
        "limit": 5,
        "windowMinutes": 15,
        "blockMinutes": 15
      },
      "account": {
        "limit": 20,
        "windowMinutes": 60,
        "blockMinutes": 60
      },
      "origin": {
        "limit": 30,
        "windowMinutes": 15,
        "blockMinutes": 15
      }
    },
    "mailThrottles": {
      "account": {
        "limit": 3,
        "windowMinutes": 60,
        "blockMinutes": 0
      },
      "origin": {
        "limit": 10,
        "windowMinutes": 60,
        "blockMinutes": 0
      }
    },
    "signInRecordRetentionDays": 90,
    "links": {
      "lifetimeMinutes": {
        "reset-password": 60,
        "enrol-second-factor": 60
      },
      "targets": {
        "admin": {
          "sign-in": "https://dispatch.au.drive.mondapac.test/sign-in",
          "accept-invitation": "https://dispatch.au.drive.mondapac.test/accept-invitation",
          "enrol-second-factor": "https://dispatch.au.drive.mondapac.test/second-factor/enrol",
          "reset-password": "https://dispatch.au.drive.mondapac.test/reset-password"
        },
        "courier": {
          "sign-in": "https://courier.au.drive.mondapac.test/sign-in",
          "accept-invitation": "https://courier.au.drive.mondapac.test/accept-invitation",
          "reset-password": "https://courier.au.drive.mondapac.test/reset-password"
        }
      }
    },
    "invitations": {
      "lifetimeMinutes": {
        "admin": 4320,
        "courier": 10080
      }
    },
    "challenges": {
      "maxAttempts": 5,
      "lifetimeSeconds": 300
    },
    "secondFactorThrottles": {
      "account": {
        "limit": 10,
        "windowMinutes": 1440,
        "blockMinutes": 1440
      }
    },
    "signOutOthersThrottle": {
      "limit": 5,
      "windowMinutes": 60,
      "blockMinutes": 0
    },
    "customRoleLimits": {
      "platform": 50
    },
    "mail": {
      "fromAddress": "no-reply@au.drive.mondapac.test",
      "fromName": "Mondapac Drive"
    }
  },
  "delivery": {
    "rateCard": {
      "vehicles": {
        "bicycle": {
          "baseFee": 700,
          "perKm": 120,
          "maxDistanceMetres": 8000,
          "maxWeightGrams": 8000,
          "maxVolumeLitres": 40,
          "temperatures": ["ambient", "chilled"]
        },
        "motorbike": {
          "baseFee": 800,
          "perKm": 130,
          "maxDistanceMetres": 25000,
          "maxWeightGrams": 15000,
          "maxVolumeLitres": 60,
          "temperatures": ["ambient", "chilled"]
        },
        "car": {
          "baseFee": 1000,
          "perKm": 150,
          "maxDistanceMetres": 60000,
          "maxWeightGrams": 50000,
          "maxVolumeLitres": 300,
          "temperatures": ["ambient", "chilled", "frozen"]
        },
        "van": {
          "baseFee": 2500,
          "perKm": 220,
          "maxDistanceMetres": 100000,
          "maxWeightGrams": 500000,
          "maxVolumeLitres": 3000,
          "temperatures": ["ambient", "chilled", "frozen"]
        }
      },
      "coldChainSurcharge": {
        "ambient": 0,
        "chilled": 300,
        "frozen": 500
      },
      "scheduledDiscountBps": 1000
    },
    "coldChain": {
      "chilled": {
        "maxCelsius": 5
      },
      "frozen": {
        "maxCelsius": -15
      }
    },
    "scheduling": {
      "minLeadMinutes": 60,
      "maxDaysAhead": 7,
      "minWindowMinutes": 60
    },
    "proofOfDelivery": {
      "pinLength": 4,
      "maxPinAttempts": 5
    },
    "responseBudget": {
      "geocodeMs": 900,
      "routeMs": 700,
      "estimateRoadFactor": 1.3,
      "geocodeCacheSeconds": 86400
    }
  },
  "routing": {
    "provider": "google",
    "google": {
      "apiKeyEnv": "GOOGLE_MAPS_API_KEY",
      "regionCode": "au",
      "travelModes": {
        "bicycle": "BICYCLE",
        "motorbike": "TWO_WHEELER",
        "car": "DRIVE",
        "van": "DRIVE"
      },
      "trafficAware": true
    },
    "timeoutMs": 2000,
    "cacheTtlSeconds": 900,
    "cacheCoordinateDecimals": 4,
    "circuitBreaker": {
      "failureThreshold": 5,
      "openSeconds": 30
    },
    "straightLine": {
      "roadFactor": 1.3,
      "speedsKmh": {
        "bicycle": 15,
        "motorbike": 30,
        "car": 30,
        "van": 25
      }
    }
  },
  "dispatch": {
    "offerTimeoutSeconds": 30,
    "waveSize": 1,
    "maxRounds": 5,
    "scheduledLeadMinutes": 45,
    "searchRadiusMetres": 8000,
    "candidateLimit": 20,
    "offerPointDecimals": 3
  },
  "notifications": {
    "webhooks": {
      "maxAttempts": 8,
      "firstRetrySeconds": 30,
      "maxRetrySeconds": 3600,
      "rotationOverlapMinutes": 1440
    },
    "sms": {
      "senderId": "Mondapac",
      "optOutText": "Reply STOP to opt out",
      "maxAttempts": 5,
      "allowedCallingCodes": ["61"],
      "templates": {
        "booked": "Your order {reference} is booked for delivery. Track it: {trackingUrl}",
        "on_the_way": "Your order {reference} is on the way. Track it: {trackingUrl}",
        "delivered": "Your order {reference} has been delivered.",
        "failed": "We could not deliver your order {reference}. The sender will contact you."
      },
      "pinText": "Your delivery PIN is {pin}.",
      "trackingPageUrl": "https://track.mondapac.com.au/t/{token}"
    },
    "push": {
      "offerTitle": "New offer",
      "offerBody": "New offer, expires in {seconds} s"
    }
  },
  "fleet": {
    "documents": [
      {
        "type": "abn",
        "employmentTypes": ["contractor"],
        "coldChainOnly": false,
        "perVehicle": false,
        "expires": false
      },
      {
        "type": "driver_licence",
        "vehicleTypes": ["motorbike", "car", "van"],
        "coldChainOnly": false,
        "perVehicle": false,
        "expires": true
      },
      {
        "type": "vehicle_registration",
        "vehicleTypes": ["motorbike", "car", "van"],
        "coldChainOnly": false,
        "perVehicle": true,
        "expires": true
      },
      {
        "type": "insurance",
        "employmentTypes": ["contractor"],
        "coldChainOnly": false,
        "perVehicle": false,
        "expires": true
      },
      {
        "type": "police_check",
        "coldChainOnly": false,
        "perVehicle": false,
        "expires": true
      },
      {
        "type": "food_handling",
        "coldChainOnly": true,
        "perVehicle": false,
        "expires": false
      }
    ],
    "businessIdDocumentType": "abn",
    "courierApp": { "supportPhone": "+61700000000", "distanceUnit": "km" }
  },
  "payouts": {
    "earnings": {
      "vehicles": {
        "bicycle": {
          "perDelivery": 550,
          "perKm": 90
        },
        "motorbike": {
          "perDelivery": 600,
          "perKm": 100
        },
        "car": {
          "perDelivery": 750,
          "perKm": 110
        },
        "van": {
          "perDelivery": 1800,
          "perKm": 160
        }
      },
      "coldChainBonus": {
        "ambient": 0,
        "chilled": 150,
        "frozen": 250
      },
      "waiting": {
        "freeMinutes": 5,
        "perMinute": 30,
        "maxPaidMinutes": 30
      }
    },
    "schedule": {
      "cadence": "weekly",
      "weekday": 1,
      "time": "03:00"
    },
    "minimumPayout": 1000,
    "tax": {
      "rateBps": 1000,
      "onTips": false,
      "businessIdRequired": true
    },
    "provider": {
      "accountCountry": "AU",
      "onboardingReturnUrl": "https://drive.mondapac.com/courier/payouts/return",
      "onboardingRefreshUrl": "https://drive.mondapac.com/courier/payouts/refresh"
    }
  },
  "tracking": {
    "ping": {
      "maxAgeSeconds": 120,
      "maxFutureSkewSeconds": 30,
      "minIntervalSeconds": 3,
      "maxAccuracyMetres": 500,
      "maxSpeedKmh": 160
    },
    "livePositionTtlSeconds": 300,
    "breadcrumbRetentionDays": 30,
    "trackingLinkTtlHours": 24,
    "streamIntervalSeconds": 5,
    "nearestCouriers": {
      "maxRadiusMetres": 20000,
      "maxResults": 50
    },
    "etaRefreshSeconds": 60
  }
}
